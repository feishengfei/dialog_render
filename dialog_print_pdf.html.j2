<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<style>
@page {
    size: A4;
    margin: 15mm;
}
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    font-family: "Noto Sans SC", system-ui, sans-serif;
    font-size: 11pt;
    line-height: 1.6;
    background: #ffffff;
    color: #111111;
}
.quiz-meta {
    text-align: center;
    margin-bottom: 24pt;
}
.quiz-meta h1 {
    font-size: 16pt;
    font-weight: bold;
    margin-bottom: 8pt;
}
.quiz-meta .subject-desc {
    font-size: 10pt;
    color: #444444;
}
.group-block {
    margin-bottom: 20pt;
}
.group-title {
    font-size: 13pt;
    font-weight: bold;
    margin-bottom: 10pt;
    padding-bottom: 4pt;
    border-bottom: 1px solid #aaaaaa;
}
/* 气泡打印样式 */
.bubble {
    width: 100%;
    border-radius: 8px;
    padding:12pt;
    margin-bottom:10pt;
    display: flex;
    gap:10pt;
    page-break-inside: avoid;
}
.avatar-box {
    flex-shrink: 0;
    width:50px;
}
.avatar-img {
    width:50px;
    height:50px;
    object-fit: cover;
    border-radius:4px;
}
.avatar-placeholder {
    width:50px;
    height:50px;
    border:1px solid #aaa;
    border-radius:4px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:9pt;
    text-align:center;
    color:#444;
}
.bubble-text {
    flex-grow: 1;
}
.bubble-text p {
    margin-bottom:6pt;
}
.bubble-text p:last-child {
    margin-bottom:0;
}
</style>
</head>
<body>
<div class="quiz-meta">
    <h1>{{ quiz_meta.title | e }}</h1>
    {% if quiz_meta.subject %}
    <div class="subject-desc">{{ quiz_meta.subject | e }}</div>
    {% endif %}
</div>

{% for g in groups %}
<div class="group-block">
    <div class="group-title">{{ g.gt | e }}</div>
    {% for bubble in g.bubbles %}
    <div class="bubble" style="background-color: {{ bubble.bubble_bg }};">
        <div class="avatar-box">
        {% if bubble.avatar_b64 %}
            <img class="avatar-img" src="{{ bubble.avatar_b64 }}" alt="{{ bubble.sp | e }}">
        {% else %}
            <div class="avatar-placeholder">{{ bubble.sp | e }}</div>
        {% endif %}
        </div>
        <div class="bubble-text">
            {% for para in bubble.txt_list %}
                <p>{{ para | e }}</p>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>
{% endfor %}
</body>
</html>
